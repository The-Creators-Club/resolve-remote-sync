{
  "id": "/",
  "name": "CC Sync",
  "short_name": "CC Sync",
  "description": "The fleet dashboard: who is syncing, what is transferring, what is wrong.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
