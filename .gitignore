.venv/
__pycache__/
.pytest_cache/
*.egg-info/
.tools/
# Fetched-once binaries the installer pushes to the NAS (the static ffmpeg
# tarball, 42 MB). MUSIC_FFMPEG_CACHE moves it elsewhere.
.cache/
dist/
build/
*.spec.bak

# Per-site manifest (tenant identity, no secrets). The example stays tracked;
# the real one is local to each admin machine (2026-08-17, SYNOLOGY_PORT_PLAN WP0).
site.toml
# ...but server/'s suite ships a site to test against: conftest.py points
# $CCSYNC_SITE at this fixture before anything imports common, so without the
# negation a fresh clone has no manifest and the whole suite fails. Caught
# 2026-08-17 while auditing this file (COMMERCIAL_READINESS.md section B); the
# fixture's siblings (empty-site.toml, site.synology.toml) never matched.
!server/tests/fixtures/site.toml

# Defence in depth for secrets and PII (COMMERCIAL_READINESS.md section B,
# 2026-08-17). No key, token, password or cookie jar has ever been committed —
# this list exists so the first accident is caught by git, not by a customer.
# Verified 2026-08-17 that no pattern below shadows an already-tracked file
# (`git ls-files | grep -iE '(\.env$|\.pem$|\.key$|cookies\.txt$|
# identity\.json$|rclone\.conf$|\.db$)'` returned nothing), so none needs a
# negation yet. If a file ever has to be tracked despite matching one, negate it
# here — `git add -f` works once and is forgotten by the next person.
.env
.env.*
*.pem
*.key
cookies.txt
youtube-cookies.txt
identity.json
rclone.conf
*.db
*.db-wal
*.db-shm

# Site-specific operator data that must never reach the product repo: one
# customer's catalogue (named projects, episode titles, camera bodies), the
# archive filename dumps and the eval query sets written against them. The
# files still live here on the base rig — see private/README.md — they are just
# not ours to ship (COMMERCIAL_READINESS.md item 10 / section B, 2026-08-17).
private/

# local vendor-feed working dir (tools/publish_feed.py --feed-dir): copies of
# artefacts + the signed channel; the GitHub release is the published truth
feed/
dist/

# Per-run output of broll/indexer/tools/make_own_proxies.py and the
# backcatalogue runner: a scan of one machine's drives (absolute Q:\ paths,
# one line per clip). Reproducible from the tree; never the same twice.
broll/indexer/proxy-prepass-*.jsonl
broll/indexer/run_backcatalogue.log
