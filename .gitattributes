# Line endings.
#
# This repo is developed on Windows with core.autocrlf=true, which rewrites
# LF to CRLF on checkout. That is harmless for the PowerShell and Python
# files, and FATAL for anything a POSIX shell has to parse: a trailing CR
# becomes part of the last token on every line.
#
# 2026-07-26: dashboard/deploy/run.sh shipped to the NAS with CRLF and the
# container crash-looped on `set -eu` with "Illegal option -" -- dash was
# reading the CR as an option character. The dashboard was down until the
# file was normalised. installer/macos_bootstrap.sh had the same defect and
# was already on the editor share, where it would have failed on the first
# Mac install.
#
# Keep these rules ahead of any new shell script: eol=lf is checked out as
# LF regardless of the developer's autocrlf setting.

* text=auto

*.sh   text eol=lf
*.bash text eol=lf

# Shell scripts run on the NAS / macOS. Anything the container or a Mac
# executes belongs here.
dashboard/deploy/run.sh   text eol=lf
installer/macos_bootstrap.sh text eol=lf
installer/macos_uninstall.sh text eol=lf
# Written on Windows, run only on the Mac (they refuse on any other uname).
tools/release_macos.sh   text eol=lf
tools/build_onboard_macos.sh text eol=lf

# Anything a Linux container BUILDS from or a CI runner parses, for the same
# reason as the shell scripts above: a CR at the end of a `RUN` line becomes
# part of the command, and a workflow file is read by a Linux YAML parser.
# Added 2026-08-17 -- broll/web/Dockerfile was LF in this working copy only by
# luck of when it was written, and `* text=auto` would have checked it out
# CRLF on the next fresh clone.
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
.github/workflows/*.yml  text eol=lf
.github/workflows/*.yaml text eol=lf
# The compose files and run.sh the NAS reads (run.sh is covered by *.sh above;
# these are the YAML beside it).
dashboard/deploy/*.yaml  text eol=lf
# sshd reads this directly, same failure mode as run.sh's -- no .sh
# extension to catch it under the pattern above, so it needs its own line
# (added with the ccsync-sftp sidecar, ZERO_TOUCH_PLAN.md WP A).
dashboard/deploy/sftp/sshd_config text eol=lf

# Windows-side scripts: CRLF is fine and matches what editors see.
*.ps1  text eol=crlf

# Binaries must never be touched.
*.exe  binary
*.png  binary
*.ico  binary

# Vendored-verbatim pairs (companion/broll_vlm <- broll_index; broll/web/app <-
# ytdl identity + indexer normalize): the release gates and
# server/tests/test_cross_component.py compare them BYTE for byte, so a CRLF
# working copy of one half is a "drift" (seen on the first merge, 2026-08-18).
broll/indexer/broll_index/*.py text eol=lf
broll/indexer/broll_index/prompts/*.md text eol=lf
broll/indexer/broll_index/normalize.py text eol=lf
companion/src/ccsync_companion/broll_vlm/** text eol=lf
companion/src/ccsync_companion/ytdl_common.py text eol=lf
ytdl/web/ytdlweb/ytdl_common.py text eol=lf
ytdl/web/ytdlweb/identity.py text eol=lf
broll/web/app/normalize.py text eol=lf
broll/web/app/identity.py text eol=lf
