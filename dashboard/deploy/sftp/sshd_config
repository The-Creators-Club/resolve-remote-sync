# sshd_config for the ccsync-sftp sidecar -- ZERO_TOUCH_PLAN.md 3.1/3.3.
#
# There is exactly one job here: an editor's rclone (lane A up, lane B down)
# speaks internal-sftp, chrooted to /jail, landing in /jail/tree. No shell,
# no port forwarding, no X11, no password auth -- ever. This REPLACES the
# NAS host's own sshd `Match Group editors` block and everything
# docs/TENANCY.md calls "the home directory trap"; see README.md in this
# directory for the chroot layout this file assumes.

Port 22
Protocol 2

# Generated ONCE by entrypoint.sh into a volume (compose:
# ${CCSYNC_DATA}/sftp-hostkeys:/etc/ssh/keys) and never again. A regenerated
# host key would make every editor's rclone refuse the NAS on the next
# connection (known_hosts mismatch) -- entrypoint.sh checks for these
# BEFORE anything else runs, precisely so a container recreate never
# touches them.
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
UsePAM no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PrintMotd no
PrintLastLog no
StrictModes yes
LogLevel INFO

# The dashboard is the identity provider (ZERO_TOUCH_PLAN.md 3.3): sshd asks
# it for each user's authorized_keys over the internal API instead of
# reading a file, so revoking an editor is one row in the dashboard's
# `users` table, not an SSH session into the NAS. `AuthorizedKeysFile none`
# turns off the file-based fallback entirely -- the API answer is the only
# source of truth, deliberately (a stray local key file would be a second,
# unaudited way in).
AuthorizedKeysCommand /usr/local/bin/ccsync-keys %u
AuthorizedKeysCommandUser nobody
AuthorizedKeysFile none

Subsystem sftp internal-sftp

# internal-sftp only, chrooted to the tree mount, landing every editor
# straight in /tree (see README.md "chroot layout" for what /jail/tree is
# bind-mounted from). Every OS account ccsync-users.sh creates is a member
# of this one `editors` group -- there is no per-editor group and no other
# Match block; per-project isolation is a follow-up once bind views are
# spiked (ZERO_TOUCH_PLAN.md section 7, S3), not this file's job today.
Match Group editors
    ChrootDirectory /jail
    ForceCommand internal-sftp -d /tree
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
